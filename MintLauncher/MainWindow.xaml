<Window x:Class="MintLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="薄荷启动器"
        Icon="Assets/mint-brandmark-v1.ico"
        Width="1180" Height="720"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="False"
        ResizeMode="CanResize" Background="{DynamicResource WindowSurface}"
        FontFamily="Microsoft YaHei UI"
        Foreground="{DynamicResource TextPrimary}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="8" CornerRadius="12" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <CubicEase x:Key="MorphEase" EasingMode="EaseOut" />

        <Style x:Key="ChoiceCardStyle" TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="Background" Value="{DynamicResource SecondarySurface}" />
        </Style>
    </Window.Resources>

    <Border x:Name="WindowSurface" Margin="0" CornerRadius="12" Background="{DynamicResource WindowSurface}"
            BorderThickness="0">
        <Grid Margin="0,0,-8,-8" ClipToBounds="False">

            <Image x:Name="BackdropImage" Source="Assets/mint-background.png" Stretch="UniformToFill" Opacity="{DynamicResource BackdropImageOpacity}" />
            <Rectangle x:Name="BackdropTint" Fill="{DynamicResource BackdropOverlay}" IsHitTestVisible="False" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="76" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource TitleBarSurface}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="Assets/mint-brandmark-v1.png" Width="38" Height="38"
                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="薄荷启动器" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="技术预览" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </StackPanel>

                        <Grid x:Name="NavHost" Grid.Column="1" VerticalAlignment="Center">
                        <Border x:Name="NavSelectionPill" Width="112" Height="42" CornerRadius="10" HorizontalAlignment="Left" Background="{DynamicResource NavSelectedSurface}" IsHitTestVisible="False">
                            <Border.RenderTransform><TranslateTransform x:Name="NavIndicatorTranslate" /></Border.RenderTransform>
                        </Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="NavLaunch" GroupName="Navigation" IsChecked="True" Style="{StaticResource NavButtonStyle}" Checked="NavLaunch_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" Margin="0,0,8,0" /><TextBlock Text="启动" /></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavInstances" GroupName="Navigation" Style="{StaticResource NavButtonStyle}" Checked="NavInstances_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7B8;" Margin="0,0,8,0" /><TextBlock Text="游戏库" /></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavDownload" GroupName="Navigation" Style="{StaticResource NavButtonStyle}" Checked="NavDownload_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE896;" Margin="0,0,8,0" /><TextBlock Text="下载" /></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavSettings" GroupName="Navigation" Style="{StaticResource NavButtonStyle}" Checked="NavSettings_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Margin="0,0,8,0" /><TextBlock Text="设置" /></StackPanel>
                            </RadioButton>
                        </StackPanel>
                        </Grid>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButtonStyle}" Content="&#xE921;" ToolTip="最小化" Click="Minimize_Click" />
                            <Button Style="{StaticResource IconButtonStyle}" Content="&#xE711;" ToolTip="关闭" Click="Close_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="ContentStage" Grid.Row="1">
                    <Grid x:Name="HomeScene" Panel.ZIndex="1">
                        <StackPanel x:Name="HomePanel" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-26,0,0">
                            <Border Width="190" Height="228" CornerRadius="14" HorizontalAlignment="Center"
                                    Background="{DynamicResource HomePreviewSurface}" BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1">
                                <Grid>
                                    <Viewport3D x:Name="HomeSkinViewport" Margin="5,3,5,41" ClipToBounds="True" Cursor="SizeAll" ToolTip="按住拖动，可从侧面查看 3D 皮肤外层" MouseLeftButtonDown="HomeSkinViewport_MouseLeftButtonDown" MouseLeftButtonUp="HomeSkinViewport_MouseLeftButtonUp" MouseMove="HomeSkinViewport_MouseMove">
                                        <Viewport3D.Camera><PerspectiveCamera Position="3,3,52" LookDirection="-3,-3,-52" UpDirection="0,1,0" FieldOfView="34" /></Viewport3D.Camera>
                                        <ModelVisual3D x:Name="HomeSkinModelVisual" />
                                    </Viewport3D>
                                    <Button x:Name="HomeChangeSkinButton" Content="更换皮肤" ToolTip="默认展示内置皮肤；尚未读取账户皮肤" Width="116" Height="30" Margin="0,0,0,8"
                                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Style="{StaticResource SoftButtonStyle}"
                                            FontSize="11" Click="HomeChangeSkin_Click" />
                                </Grid>
                            </Border>

                            <TextBlock Text="准备好就出发吧" Margin="0,10,0,16" HorizontalAlignment="Center"
                                       FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />

                            <Button x:Name="AccountButton" Height="72" Style="{StaticResource SoftButtonStyle}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Click="AccountButton_Click">
                                <Grid Margin="13,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="34" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource AvatarSurface}">
                                        <Grid>
                                            <TextBlock Text="R" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AvatarText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Border Width="13" Height="13" CornerRadius="7" Background="#64D3C4" BorderBrush="White" BorderThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock x:Name="HomeAccountName" Text="Player" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="离线档案 · 仅本机" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource IconMuted}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Grid>
                            </Button>

                            <Button x:Name="InstanceButton" Height="48" Margin="0,14,0,0" Background="{DynamicResource InstancePillSurface}" Style="{StaticResource SoftButtonStyle}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Click="InstanceButton_Click">
                                <Grid Margin="16,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource BrandBlue}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock x:Name="GameSummary" Grid.Column="1" Text="未选择游戏" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource IconMuted}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <Grid Height="74" Margin="0,14,0,0">
                            <Button x:Name="LaunchButton" Height="74" Background="{DynamicResource BrandBlue}" Foreground="White" BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}" Click="LaunchButton_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="LaunchSurface" Background="{TemplateBinding Background}" CornerRadius="14">
                                            <Grid Margin="22,0">
                                                <StackPanel x:Name="LaunchReadyContent" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="19" Margin="0,0,12,0" />
                                                    <TextBlock x:Name="LaunchButtonText" Text="启动游戏" FontSize="18" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="LaunchSurface" Property="Background" Value="#0879CC" /></Trigger>
                                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="LaunchSurface" Property="Opacity" Value="0.88" /></Trigger>
                                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="LaunchSurface" Property="Opacity" Value="0.82" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Rectangle x:Name="LaunchProgressOutline" RadiusX="14" RadiusY="14" Stroke="#A2E2FF" StrokeThickness="3" StrokeDashArray="28 160" Visibility="Collapsed" IsHitTestVisible="False">
                                <Rectangle.Effect><DropShadowEffect Color="#4CC8FF" BlurRadius="13" ShadowDepth="0" Opacity="0.9" /></Rectangle.Effect>
                            </Rectangle>
                            <ProgressBar x:Name="LaunchProgress" Visibility="Collapsed" Minimum="0" Maximum="100" Height="5" Margin="8,0,8,5" VerticalAlignment="Bottom"
                                         Foreground="#BDE9FF" Background="#3DFFFFFF" BorderThickness="0" IsHitTestVisible="False" />
                            </Grid>

                            <StackPanel Height="28" Margin="0,9,0,0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="EnvironmentStatus" Text="正在读取本机游戏目录…"
                                           MaxWidth="360" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                           FontSize="11" Foreground="{DynamicResource StatusText}" VerticalAlignment="Center" />
                                <Button x:Name="LaunchIssueButton" Content="查看原因" Margin="9,0,0,0" Padding="8,4" FontSize="11"
                                        Visibility="Collapsed" Style="{StaticResource SoftButtonStyle}" Click="LaunchIssueButton_Click" />
                            </StackPanel>
                        </StackPanel>
                        <Grid x:Name="LaunchIssueOverlay" Panel.ZIndex="5" Visibility="Collapsed" Background="{DynamicResource DimmerSurface}">
                            <Border Width="540" MaxWidth="540" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Padding="24" CornerRadius="16" Background="{DynamicResource ModalSurface}">
                                <StackPanel>
                                    <TextBlock x:Name="LaunchIssueTitle" Text="游戏暂时无法启动" FontSize="18" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock x:Name="LaunchIssueDetail" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="13"
                                               LineHeight="23" Foreground="{DynamicResource TextSecondary}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                                        <Button x:Name="OpenIssueDirectoryButton" Content="打开实例目录" Height="36" Padding="16,0" Margin="0,0,10,0"
                                                Style="{StaticResource SoftButtonStyle}" Visibility="Collapsed" Click="OpenIssueDirectory_Click" />
                                        <Button Content="知道了" Height="36" Padding="18,0" Background="{DynamicResource BrandBlue}" Foreground="White"
                                                Style="{StaticResource SoftButtonStyle}" Click="CloseLaunchIssue_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <Border x:Name="Dimmer" Panel.ZIndex="10" Background="{DynamicResource DimmerSurface}" Opacity="0" Visibility="Collapsed" MouseLeftButtonDown="Dimmer_MouseLeftButtonDown" />

                    <Border x:Name="AccountMorphShadow" Panel.ZIndex="19" Width="760" Height="382" Margin="0"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource ModalSurface}"
                            CornerRadius="16" Visibility="Collapsed" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><TransformGroup><ScaleTransform x:Name="AccountShadowScale" /><TranslateTransform x:Name="AccountShadowTranslate" /></TransformGroup></Border.RenderTransform>
                    </Border>

                    <Border x:Name="AccountMorphCard" Panel.ZIndex="20" Width="760" Height="382" Margin="0"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource ModalSurface}"
                            CornerRadius="16" Visibility="Collapsed" ClipToBounds="True" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><TransformGroup><ScaleTransform x:Name="AccountCardScale" /><TranslateTransform x:Name="AccountCardTranslate" /></TransformGroup></Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid Margin="14,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                                <Border x:Name="AccountHeaderAvatar" Width="48" Height="48" CornerRadius="12" Background="{DynamicResource AvatarSurface}">
                                    <TextBlock Text="R" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AvatarText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Button x:Name="AccountBackButton" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Style="{StaticResource IconButtonStyle}" Content="&#xE72B;" Click="BackToAccounts_Click" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock x:Name="AccountHeaderTitle" Text="选择账户" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock x:Name="AccountHeaderSubtitle" Text="启动前使用的游戏身份" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Content="&#xE711;" Click="CloseAccount_Click" />
                            </Grid>

                            <StackPanel x:Name="AccountOptions" Grid.Row="1" Margin="24,8,24,22" Opacity="0">
                                <Button Height="76" Background="{DynamicResource SelectionSurface}" Style="{StaticResource SoftButtonStyle}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Click="ChooseAccount_Click">
                                    <Grid Margin="14,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
                                        <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource AvatarSurface}"><TextBlock Text="R" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AvatarText}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock x:Name="AccountOptionName" Text="Player" FontWeight="SemiBold" /><TextBlock x:Name="AccountOptionSubtitle" Text="离线档案 · 当前账户" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0" /></StackPanel>
                                        <TextBlock Grid.Column="2" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource BrandBlue}" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Button Height="58" Margin="0,10,0,0" Background="{DynamicResource SecondarySurface}" Style="{StaticResource SoftButtonStyle}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Click="OpenSkinEditor_Click">
                                    <Grid Margin="15,0"><Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource IconPinkSurface}"><TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" Foreground="#E789AA" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock Text="皮肤工作台" FontWeight="SemiBold" /><TextBlock Text="本地预览 · 模型选择 · 上传接口" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0" /></StackPanel><TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource IconMuted}" VerticalAlignment="Center" HorizontalAlignment="Center" /></Grid>
                                </Button>
                                <Button Height="58" Margin="0,10,0,0" Background="{DynamicResource SecondarySurface}" Style="{StaticResource SoftButtonStyle}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Click="OpenAccountAdd_Click">
                                    <Grid Margin="15,0"><Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="14" Background="{DynamicResource IconBlueSurface}"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource BrandBlue}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock Text="添加账户" FontWeight="SemiBold" /><TextBlock Text="微软登录或离线档案" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0" /></StackPanel><TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource IconMuted}" VerticalAlignment="Center" HorizontalAlignment="Center" /></Grid>
                                </Button>
                                <Button x:Name="SwitchToOfflineButton" Content="切换为本机离线档案" Height="26" Margin="8,8,0,0" HorizontalAlignment="Left" Style="{StaticResource IconButtonStyle}" Click="SwitchToOffline_Click" Visibility="Collapsed" />
                            </StackPanel>

                            <Grid x:Name="AccountAddPanel" Grid.Row="1" Margin="24,6,24,22" Visibility="Collapsed" Opacity="0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="86" /><RowDefinition Height="*" /><RowDefinition Height="44" /></Grid.RowDefinitions>
                                <TextBlock Text="选择登录方式" FontSize="13" FontWeight="SemiBold" />
                                <Grid Grid.Row="1" Margin="0,9,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Button x:Name="MicrosoftMethodButton" Grid.Column="0" Margin="0,0,6,0" Tag="Microsoft" Background="{DynamicResource SelectionSurface}" Style="{StaticResource SoftButtonStyle}" HorizontalContentAlignment="Stretch" Click="SelectAccountMethod_Click">
                                        <Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE909;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource BrandBlue}" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" /><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0"><TextBlock Text="微软账户" FontWeight="SemiBold" /><TextBlock Text="正版登录" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0" /></StackPanel></Grid>
                                    </Button>
                                    <Button x:Name="OfflineMethodButton" Grid.Column="1" Margin="6,0,0,0" Tag="Offline" Background="{DynamicResource SecondarySurface}" Style="{StaticResource SoftButtonStyle}" HorizontalContentAlignment="Stretch" Click="SelectAccountMethod_Click">
                                        <Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource BrandMint}" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" /><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0"><TextBlock Text="离线档案" FontWeight="SemiBold" /><TextBlock Text="仅保存在本机" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0" /></StackPanel></Grid>
                                    </Button>
                                </Grid>
                                <Border Grid.Row="2" Background="{DynamicResource SecondarySurface}" CornerRadius="12" Padding="16,10">
                                    <Grid>
                                        <StackPanel x:Name="MicrosoftLoginPreview" VerticalAlignment="Center"><TextBlock Text="浏览器将打开微软授权页面" FontWeight="SemiBold" /><TextBlock Text="登录完成后自动返回启动器；不会在本地保存密码。" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,0" /><TextBlock x:Name="MicrosoftLoginError" Visibility="Collapsed" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextPrimary}" Margin="0,8,0,0" /></StackPanel>
                                        <StackPanel x:Name="OfflineLoginPreview" Visibility="Collapsed" VerticalAlignment="Center"><TextBlock Text="离线玩家 ID" FontSize="10" Foreground="{DynamicResource TextSecondary}" /><TextBox x:Name="OfflineNameInput" Text="Player" Margin="0,5,0,0" Height="30" Padding="9,4" Background="{DynamicResource SoftSurface}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource WindowBorder}" TextChanged="OfflineNameInput_TextChanged" /><TextBlock Text="ID 规范：3–16 位英文字母、数字或下划线（_）；不含空格、中文或其他符号。" Margin="0,7,0,0" TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource TextSecondary}" /><TextBlock x:Name="OfflineNameHint" Text="Player 是通用默认名，容易重名；离线档案无法进入要求正版验证的服务器。" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource TextSecondary}" /></StackPanel>
                                    </Grid>
                                </Border>
                                <Button x:Name="AccountAddActionButton" Grid.Row="3" Margin="0,8,0,0" Background="{DynamicResource BrandBlue}" Foreground="White" Style="{StaticResource SoftButtonStyle}" Click="AccountAddDemo_Click"><TextBlock x:Name="AccountAddActionText" Text="使用微软账户登录" FontWeight="SemiBold" /></Button>
                            </Grid>

                            <Grid x:Name="SkinEditorPanel" Grid.Row="1" Margin="24,4,24,22" Visibility="Collapsed" Opacity="0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="246" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Margin="0,0,18,0" Background="{DynamicResource SecondarySurface}" CornerRadius="14" Padding="14">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Border Background="{DynamicResource SoftSurface}" CornerRadius="10" Padding="10">
                                            <Grid>
                                                <TextBlock x:Name="SkinPreviewPlaceholder" Text="选择 64×64 PNG&#x0a;在这里预览皮肤" TextAlignment="Center" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                                <Viewport3D x:Name="SkinViewport" ClipToBounds="True" Cursor="SizeAll" MouseLeftButtonDown="SkinViewport_MouseLeftButtonDown" MouseLeftButtonUp="SkinViewport_MouseLeftButtonUp" MouseMove="SkinViewport_MouseMove">
                                                    <Viewport3D.Camera><PerspectiveCamera Position="0,1.5,56" LookDirection="0,-1.5,-56" UpDirection="0,1,0" FieldOfView="34" /></Viewport3D.Camera>
                                                    <ModelVisual3D x:Name="SkinModelVisual" />
                                                </Viewport3D>
                                                <Image x:Name="SkinTexturePreview" Visibility="Collapsed" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="3D 角色预览 · 按住拖动旋转" FontSize="10" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,9,0,0" />
                                    </Grid>
                                </Border>
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="70" /><RowDefinition Height="*" /><RowDefinition Height="42" /></Grid.RowDefinitions>
                                    <StackPanel><TextBlock Text="角色模型" FontSize="11" Foreground="{DynamicResource TextSecondary}" /><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Button x:Name="SteveModelButton" Tag="Steve" Margin="0,0,5,0" Background="{DynamicResource SelectionSurface}" Foreground="{DynamicResource TextPrimary}" Style="{StaticResource SoftButtonStyle}" Content="Steve · 经典手臂" Click="SelectSkinModel_Click" /><Button x:Name="AlexModelButton" Tag="Alex" Grid.Column="1" Margin="5,0,0,0" Background="{DynamicResource SecondarySurface}" Foreground="{DynamicResource TextPrimary}" Style="{StaticResource SoftButtonStyle}" Content="Alex · 纤细手臂" Click="SelectSkinModel_Click" /></Grid></StackPanel>
                                    <Button Grid.Row="1" Margin="0,10,0,8" Background="{DynamicResource SecondarySurface}" Style="{StaticResource SoftButtonStyle}" HorizontalContentAlignment="Stretch" Click="ChooseSkinFile_Click"><Grid Margin="15,0"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource BrandBlue}" VerticalAlignment="Center" /><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="选择本地皮肤 PNG" FontWeight="SemiBold" /><TextBlock x:Name="SkinFileName" Text="Minecraft 默认 Steve" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" /></StackPanel></Grid></Button>
